{
  "name": "triptracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node server.js",
    "dev:web": "vite --host 127.0.0.1",
    "generate:airlines": "node scripts/generate-airlines.mjs",
    "generate:airports": "node scripts/generate-airports.mjs",
    "generate:runways": "node scripts/generate-runways.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.539.0",
    "nodemailer": "^9.0.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "tz-lookup": "^6.1.25",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.4"
  }
}
